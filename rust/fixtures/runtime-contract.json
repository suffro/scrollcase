    {
      "name": "a native binary is the command itself, with nothing in front of it",
      "runtime": "native",
      "platform": "linux",
      "execution": {
        "kind": "native-binary",
        "binary": "bin/tool",
        "defaultArgs": [
          "--serve",
          "8080"
        ]
