{
  "$schema": "https://scrollcase.dev/schema/v3/scroll.schema.json",
  "schemaVersion": 3,
  "boxId": "transcode-demo",
  "version": "1.0.0",
  "sourceRevision": "ffmpeg-9-conda-forge",
  "compatibility": {
    "minHostAppVersion": "1.0.0"
  },
  "runtime": {
    "id": "native"
  },
  "pixiVersion": "0.73.0",
  "cacheSubdir": "cache/transcode-demo",
  "selfTest": {
    "commands": [
      {
        "args": [
          "-version"
        ]
      },
      {
        "args": [
          "-f",
          "lavfi",
          "-i",
          "testsrc=duration=1:size=320x240:rate=10",
          "-c:v",
          "libx264",
          "-f",
          "null",
          "-"
        ]
      }
    ]
  },
  "execution": {
    "kind": "native-binary",
    "binary": "venv/bin/ffmpeg",
    "defaultArgs": [
      "-hide_banner"
    ]
  }
}
